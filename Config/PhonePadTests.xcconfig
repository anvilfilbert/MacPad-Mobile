BUNDLE_LOADER = $(TEST_HOST)
CODE_SIGN_STYLE = Automatic
GENERATE_INFOPLIST_FILE = YES
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/Frameworks @loader_path/Frameworks
PRODUCT_BUNDLE_IDENTIFIER = com.anvilfilbert.PhonePadTests
PRODUCT_MODULE_NAME = PhonePadTests
PRODUCT_NAME = PhonePadTests
SKIP_INSTALL = YES
SUPPORTS_MACCATALYST = NO
TEST_HOST = $(BUILT_PRODUCTS_DIR)/PhonePad.app/$(BUNDLE_EXECUTABLE_FOLDER_PATH)/PhonePad
